{
  "name": "motion-slides",
  "version": "0.1.0",
  "description": "Turn a storyboard brief into a narrated, captioned explainer MP4, entirely on the local machine.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "bin": {
    "motion-slides": "bin/motion-slides.js"
  },
  "scripts": {
    "format:check": "biome format .",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.stage.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "14.0.3",
    "gsap": "3.15.0",
    "playwright-core": "1.59.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
